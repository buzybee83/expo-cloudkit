{
  "name": "expo-cloudkit",
  "version": "0.5.0",
  "description": "Expo native module for CloudKit — records, zones, sharing, and sync",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "ios",
    "plugin",
    "app.plugin.js",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p plugin/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf build",
    "test": "jest"
  },
  "keywords": [
    "expo",
    "cloudkit",
    "icloud",
    "react-native",
    "ios",
    "sync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buzybee83/expo-cloudkit"
  },
  "bugs": {
    "url": "https://github.com/buzybee83/expo-cloudkit/issues"
  },
  "homepage": "https://github.com/buzybee83/expo-cloudkit#readme",
  "peerDependencies": {
    "expo": ">=51.0.0",
    "expo-modules-core": ">=1.12.0",
    "react": ">=18.0.0",
    "tsl-apple-cloudkit": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "tsl-apple-cloudkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-modules-core": "^1.12.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.84.1",
    "react-test-renderer": "^19.2.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}
