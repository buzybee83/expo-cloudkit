{
  "name": "expo-cloudkit",
  "version": "0.1.0",
  "description": "Expo native module for CloudKit — records, zones, sharing, and sync",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "ios",
    "plugin",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf build",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!(expo-modules-core|@expo)/)"
    ],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "strict": true } }]
    },
    "modulePathIgnorePatterns": ["<rootDir>/example/"]
  },
  "keywords": [
    "expo",
    "cloudkit",
    "icloud",
    "react-native",
    "ios",
    "sync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atlas-ledger/expo-cloudkit"
  },
  "bugs": {
    "url": "https://github.com/atlas-ledger/expo-cloudkit/issues"
  },
  "homepage": "https://github.com/atlas-ledger/expo-cloudkit#readme",
  "peerDependencies": {
    "expo": ">=51.0.0",
    "expo-modules-core": ">=1.12.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@types/jest": "^30.0.0",
    "expo-modules-core": "^1.12.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}
