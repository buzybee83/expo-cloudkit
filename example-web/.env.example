# CloudKit Web Services API token.
# Obtain from: CloudKit Dashboard → your container → API Access → Tokens
# The token must have at least "public data read" scope.
# For private database access (sign-in), your container must also be set up
# in CloudKit Dashboard with the correct bundle ID and entitlements.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
EXPO_PUBLIC_CLOUDKIT_API_TOKEN=your_api_token_here
