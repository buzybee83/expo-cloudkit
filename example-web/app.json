{
  "expo": {
    "name": "CloudKit Example",
    "slug": "expo-cloudkit-example-web",
    "version": "1.0.0",
    "platforms": ["ios", "web"],
    "scheme": "cloudkit-example",
    "plugins": [
      [
        "expo-cloudkit",
        {
          "iCloudContainerEnvironment": "Development",
          "containerIds": ["iCloud.com.example.cloudkit-demo"]
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
